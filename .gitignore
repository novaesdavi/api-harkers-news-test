## .gitignore for .NET / Visual Studio projects
## Ignored files include build outputs, user-specific files,
## IDE/editor settings, temporary files, logs, and secrets.

# Build outputs
/bin/
/obj/
/out/
artifacts/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider/IntelliJ
.idea/
*.iml

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
.nuget/
project.lock.json
project.fragment.lock.json

# Logs and test results
*.log
TestResults/
*.trx
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Coverage
coverage/
coverage*.json
*.lcov

# Temporary files
*.tmp
*.temp
*~

# OS files
.DS_Store
Thumbs.db

# Databases and backups
*.ldb
*.sqlite
*.db
*.bak

# Certificates and keys
*.pfx
*.cer
*.key

# Environment and secrets
.env
.env.*.local
secrets.json
secrets.*

# Source control helpers
*.vspscc
*.vssscc

# Compiled binaries
*.dll
*.exe
*.pdb

# Node
node_modules/
npm-debug.log

# Misc
*.cache
*.binlog